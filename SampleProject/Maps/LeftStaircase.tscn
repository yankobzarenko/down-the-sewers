[sub_resource type="GDScript" id="GDScript_vvffc"]
script/source = "extends Node2D

@export var repeat: int

func _ready() -> void:
	for i in repeat:
		# Fill the pool with lava.
		var lava := get_child(0).duplicate()
		lava.position.x += (i + 1) * 64
		add_child(lava)

func lava_enter(body: Node2D) -> void:
	if body.is_in_group(&\"player\"):
		# Kill the player when entering lava.
		body.kill()
"

